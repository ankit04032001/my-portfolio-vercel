# Google Tag Manager (Optional)
# Get your GTM ID from https://tagmanager.google.com/
NEXT_PUBLIC_GTM=GTM-XXXXXXX

# askAnkit Chatbot API URL (Required for chatbot functionality)
# Your hosted FastAPI chatbot endpoint
NEXT_PUBLIC_CHATBOT_API_URL=

# Resume URL (Required)
# Direct link to your resume (Google Drive, Dropbox, or any public URL)
NEXT_PUBLIC_RESUME_URL=

# Note: All variables prefixed with NEXT_PUBLIC_ are exposed to the browser
